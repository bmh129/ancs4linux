<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <policy user="root">
    <allow own="ancs4linux.Advertising"/>
    <allow send_destination="ancs4linux.Advertising"/>
    <allow receive_sender="ancs4linux.Advertising"/>
  </policy>

  <policy group="ancs4linux">
    <allow send_destination="ancs4linux.Advertising"
           send_interface="ancs4linux.Advertising"
           send_member="GetAllHci"/>
    <allow send_destination="ancs4linux.Advertising"
           send_interface="ancs4linux.Advertising"
           send_member="EnableAdvertising"/>
    <allow send_destination="ancs4linux.Advertising"
           send_interface="ancs4linux.Advertising"
           send_member="DisableAdvertising"/>
    <allow send_destination="ancs4linux.Advertising"
           send_interface="ancs4linux.Advertising"
           send_member="EnablePairing"/>
    <allow send_destination="ancs4linux.Advertising"
           send_interface="ancs4linux.Advertising"
           send_member="DisablePairing"/>
    <allow send_destination="ancs4linux.Advertising"
           send_interface="ancs4linux.Advertising"
           send_member="ConfirmPairing"/>
    <allow receive_sender="ancs4linux.Advertising"
           receive_interface="ancs4linux.Advertising"
           receive_member="PairingConfirmationRequested"/>
  </policy>
</busconfig>
